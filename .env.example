# Claude API key (https://console.anthropic.com). Needed for the AI agent; the scripted demo works without it.
ANTHROPIC_API_KEY=
# Optional: model used by the agent (default claude-opus-5-5). claude-haiku-5-5 is much cheaper for quick iterations.
BLINDSPOT_MODEL=
# Optional: server port (default 3000)
PORT=
# Optional: interface the server listens on (default 127.0.0.1, this machine only). 0.0.0.0 exposes it to the network
# (the Docker image sets it). Only do that with BLINDSPOT_PUBLIC=1 or behind authentication: see docs/DEPLOY.md.
HOST=
# Optional: max number of tests running at once (default 2)
BLINDSPOT_MAX_RUNS=
# Public (internet-facing) instance: set to 1 to refuse private/local URLs and disable the Claude agent. See docs/DEPLOY.md.
BLINDSPOT_PUBLIC=
# With BLINDSPOT_PUBLIC=1, set to 1 to allow the Claude agent anyway (put the instance behind authentication first).
BLINDSPOT_ALLOW_CLAUDE=
